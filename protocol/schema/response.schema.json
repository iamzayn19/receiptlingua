{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receiptlingua.dev/protocol/schema/response.schema.json",
  "title": "ReceiptLingua OCR Response",
  "description": "Envelope returned by the sidecar for a successful OCR request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "engine_version",
    "mode",
    "image",
    "processing_time_ms",
    "languages",
    "scripts",
    "full_text",
    "text_lines",
    "warnings",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semantic version of this protocol schema, e.g. \"0.1.0\". Clients use this to detect incompatible responses.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engine": {
      "type": "string",
      "description": "Name of the OCR backend that produced this response, e.g. \"paddleocr\", \"tesseract\", \"surya\".",
      "minLength": 1
    },
    "engine_version": {
      "type": "string",
      "description": "Version string of the backend/model used, as reported by the backend itself.",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "description": "Requested processing mode.",
      "enum": ["fast", "accurate", "auto"]
    },
    "image": {
      "$ref": "#/$defs/image_metadata"
    },
    "processing_time_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Wall-clock time spent processing this request, in milliseconds."
    },
    "languages": {
      "type": "array",
      "description": "Languages detected across the whole document, most confident first.",
      "items": { "$ref": "#/$defs/language" }
    },
    "scripts": {
      "type": "array",
      "description": "ISO 15924 four-letter script codes detected across the whole document.",
      "items": { "$ref": "#/$defs/iso15924_code" }
    },
    "full_text": {
      "type": "string",
      "description": "Concatenated recognized text in reading order."
    },
    "text_lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/text_line" }
    },
    "words": {
      "type": "array",
      "description": "Optional word/token-level detail. Omitted when the backend or mode does not produce token-level output.",
      "items": { "$ref": "#/$defs/word" }
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal issues encountered while processing (e.g. low confidence, partial detection).",
      "items": { "type": "string" }
    },
    "fields": {
      "$ref": "#/$defs/structured_fields"
    }
  },
  "$defs": {
    "field_status": {
      "type": "string",
      "description": "Confidence/derivation status of a structured field extraction.",
      "enum": ["ok", "inferred_field", "uncertain", "missing"]
    },
    "evidence": {
      "type": "object",
      "description": "Links a structured field's value back to the source text_lines/words it was derived from.",
      "additionalProperties": false,
      "properties": {
        "text_line_indices": {
          "type": "array",
          "description": "Indices into the top-level text_lines array.",
          "items": { "type": "integer", "minimum": 0 }
        },
        "word_indices": {
          "type": "array",
          "description": "Indices into the top-level words array, when word-level detail is present.",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "scalar_field": {
      "type": "object",
      "description": "Generic wrapper for a single extracted structured field value.",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "value": {},
        "status": { "$ref": "#/$defs/field_status" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "line_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "description": { "$ref": "#/$defs/scalar_field" },
        "quantity": { "$ref": "#/$defs/scalar_field" },
        "unit_price": { "$ref": "#/$defs/scalar_field" },
        "item_total": { "$ref": "#/$defs/scalar_field" },
        "status": { "$ref": "#/$defs/field_status" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "structured_fields": {
      "type": "object",
      "description": "Receipt fields extracted from the recognized text, each carrying its own status and evidence back to text_lines/words.",
      "additionalProperties": false,
      "properties": {
        "merchant": { "$ref": "#/$defs/scalar_field" },
        "merchant_address": { "$ref": "#/$defs/scalar_field" },
        "date": { "$ref": "#/$defs/scalar_field" },
        "time": { "$ref": "#/$defs/scalar_field" },
        "currency": { "$ref": "#/$defs/scalar_field" },
        "subtotal": { "$ref": "#/$defs/scalar_field" },
        "tax": { "$ref": "#/$defs/scalar_field" },
        "discounts": { "$ref": "#/$defs/scalar_field" },
        "total": { "$ref": "#/$defs/scalar_field" },
        "payment_method": { "$ref": "#/$defs/scalar_field" },
        "receipt_number": { "$ref": "#/$defs/scalar_field" },
        "line_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/line_item" }
        }
      }
    },
    "recognition_status": {
      "type": "string",
      "description": "Status of a recognized unit (line, word, or structured field).",
      "enum": ["ok", "illegible", "truncated", "missing_region", "uncertain"]
    },
    "polygon": {
      "type": "array",
      "description": "Bounding polygon as a sequence of [x, y] points in image pixel coordinates, in order (e.g. top-left, top-right, bottom-right, bottom-left for a quadrilateral).",
      "minItems": 3,
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "bbox": {
      "type": "object",
      "description": "Axis-aligned bounding box in image pixel coordinates.",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "text_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "bbox", "confidence", "status"],
      "properties": {
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "polygon": { "$ref": "#/$defs/polygon" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag for this line, if determined.",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
        },
        "script": { "$ref": "#/$defs/iso15924_code" },
        "status": { "$ref": "#/$defs/recognition_status" }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "bbox", "confidence", "status"],
      "properties": {
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "polygon": { "$ref": "#/$defs/polygon" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
        },
        "script": { "$ref": "#/$defs/iso15924_code" },
        "status": { "$ref": "#/$defs/recognition_status" },
        "line_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the top-level text_lines array that this word belongs to."
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "confidence"],
      "properties": {
        "code": {
          "type": "string",
          "description": "BCP 47 language tag, e.g. \"en\", \"ta\", \"ar\".",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "iso15924_code": {
      "type": "string",
      "description": "ISO 15924 four-letter script code, e.g. \"Latn\", \"Taml\", \"Arab\".",
      "pattern": "^[A-Z][a-z]{3}$"
    },
    "image_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "format"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": {
          "type": "string",
          "description": "Detected image format/container, e.g. \"jpeg\", \"png\", \"heic\".",
          "minLength": 1
        },
        "exif_orientation": {
          "type": "integer",
          "description": "EXIF orientation tag (1-8) as read from the source image, before any normalization. Omitted when the image has no EXIF orientation tag.",
          "minimum": 1,
          "maximum": 8
        }
      }
    }
  }
}
